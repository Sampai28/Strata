# ACTIVE TIER — medium.
#
# Selected by detection, not by preference. Docker reports 15.27 GiB available
# (WSL2 default of half the 31.3 GiB host), which lands in the 10–24 GB band.
# See docs/BUILD_NOTES.md for the detection output and the reasoning.
#
# To change tier, copy configs/tier-large.env or configs/tier-small.env over
# this file. Compose reads it via `env_file`, so nothing else needs editing.

STRATA_TIER=medium

# ---- HDFS ------------------------------------------------------------------
# Reduced heaps. The default HADOOP_HEAPSIZE_MAX is a quarter of container RAM,
# which on a bounded container is both too small to be safe and too large to
# leave room for anything else. Setting it explicitly makes the budget legible.
NAMENODE_MEM=1200m
NAMENODE_CPUS=1.0
DATANODE_MEM=1200m
DATANODE_CPUS=1.0
HADOOP_HEAP=768m

# ---- Hive ------------------------------------------------------------------
POSTGRES_MEM=384m
POSTGRES_CPUS=0.5
METASTORE_MEM=1024m
METASTORE_CPUS=1.0
HIVESERVER2_MEM=1024m
HIVESERVER2_CPUS=1.0
HIVE_HEAP=640m

# ---- Spark -----------------------------------------------------------------
SPARK_MASTER_MEM=768m
SPARK_MASTER_CPUS=0.5

# One worker at this tier. SPARK_WORKER_MEMORY is what Spark will hand out to
# executors; the container limit is deliberately higher to leave room for JVM
# overhead, off-heap buffers and the Python worker processes. Setting them equal
# is the classic way to get an executor OOM-killed by the kernel rather than
# reported cleanly by Spark.
SPARK_WORKER_COUNT=1
SPARK_WORKER_MEM=4608m
SPARK_WORKER_CPUS=4.0
SPARK_WORKER_MEMORY=4g
SPARK_WORKER_CORES=4

SPARK_HISTORY_MEM=512m
SPARK_HISTORY_CPUS=0.5

# The driver runs here in client mode, so this container needs real memory.
SPARK_CLIENT_MEM=1536m
SPARK_CLIENT_CPUS=2.0

# Total committed: ~12.3 GiB of 15.27 GiB, leaving headroom for the WSL2 VM
# itself and for page cache — which matters more than it looks, because every
# "bytes read" figure in the experiments is affected by what is already cached.
