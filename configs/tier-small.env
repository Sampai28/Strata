# Small tier — under 10 GB usable. HDFS is dropped; MinIO + S3A takes its place.
#
# Not active on this machine. Activate with:
#     cp configs/tier-small.env configs/tier.env
#     docker compose -f docker/docker-compose.yml --profile minio up -d
#
# What this substitution costs, stated plainly rather than buried:
#
#   - There are no HDFS blocks, so `hdfs fsck` has nothing to report. Experiment
#     3's block-count evidence becomes an object count from `mc ls --recursive`.
#     The underlying lesson survives — thousands of tiny objects are still one
#     task and one request each — but the NameNode heap argument does not,
#     because there is no NameNode.
#   - `hdfs dfsadmin -report` and the block-level parts of the cheatsheet do not
#     apply.
#   - Everything about partitioning, file format, file size and bucketing behaves
#     the same way, because those are properties of how Spark writes and reads,
#     not of what stores the bytes.
#
# The HDFS variant remains available as the default profile for a larger machine.

STRATA_TIER=small

MINIO_MEM=768m
MINIO_CPUS=1.0

POSTGRES_MEM=256m
POSTGRES_CPUS=0.5
METASTORE_MEM=768m
METASTORE_CPUS=0.5
HIVESERVER2_MEM=768m
HIVESERVER2_CPUS=0.5
HIVE_HEAP=512m

SPARK_MASTER_MEM=512m
SPARK_MASTER_CPUS=0.5
SPARK_WORKER_COUNT=1
SPARK_WORKER_MEM=2560m
SPARK_WORKER_CPUS=2.0
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2

# History server is dropped at this tier. Event logs are still written and can
# be parsed offline by src/strata/metrics — the UI is the only thing lost.
SPARK_HISTORY_MEM=256m
SPARK_HISTORY_CPUS=0.25

SPARK_CLIENT_MEM=1g
SPARK_CLIENT_CPUS=1.0

# Unused at this tier, present so compose variable interpolation does not fail.
NAMENODE_MEM=1g
NAMENODE_CPUS=0.5
DATANODE_MEM=1g
DATANODE_CPUS=0.5
HADOOP_HEAP=512m
