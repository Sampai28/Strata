# Large tier — 24 GB or more usable.
#
# Not active. To use it: raise the WSL2 allocation first (see
# docs/wslconfig-recommended), restart WSL, then copy this over configs/tier.env.
# Setting these limits without raising the VM allocation just means the kernel
# OOM-kills containers instead of Spark reporting a clean failure.
#
# Two workers rather than one bigger worker: it makes shuffle across executors
# real rather than node-local, which matters for experiments 4 and 5. A single
# worker can hide shuffle cost that a real cluster would expose.

STRATA_TIER=large

NAMENODE_MEM=2g
NAMENODE_CPUS=1.5
DATANODE_MEM=2g
DATANODE_CPUS=1.5
HADOOP_HEAP=1536m

POSTGRES_MEM=512m
POSTGRES_CPUS=1.0
METASTORE_MEM=2g
METASTORE_CPUS=1.0
HIVESERVER2_MEM=2g
HIVESERVER2_CPUS=1.0
HIVE_HEAP=1536m

SPARK_MASTER_MEM=1g
SPARK_MASTER_CPUS=1.0
SPARK_WORKER_COUNT=2
SPARK_WORKER_MEM=4608m
SPARK_WORKER_CPUS=3.0
SPARK_WORKER_MEMORY=4g
SPARK_WORKER_CORES=3

SPARK_HISTORY_MEM=1g
SPARK_HISTORY_CPUS=0.5

SPARK_CLIENT_MEM=2g
SPARK_CLIENT_CPUS=2.0
