# Hadoop configuration, injected as environment variables.
#
# The official apache/hadoop image generates its XML config files at container
# start from environment variables named <FILE>_<property>. So
# `HDFS-SITE.XML_dfs.replication=1` becomes the dfs.replication property in
# hdfs-site.xml. This is why there are no hdfs-site.xml files in this repo — the
# image builds them, and a mounted XML would be overwritten.

CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_hadoop.http.staticuser.user=root
CORE-SITE.XML_hadoop.tmp.dir=/hadoop/tmp

# Replication 1 because this is a single DataNode. The default of 3 would leave
# every block permanently under-replicated and fsck reporting the filesystem as
# CORRUPT, which would make experiment 3's fsck output unreadable.
HDFS-SITE.XML_dfs.replication=1

HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.http-address=0.0.0.0:9870
HDFS-SITE.XML_dfs.namenode.name.dir=file:///hadoop/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=file:///hadoop/dfs/data

# 128MB, the default, stated explicitly because experiment 3 is entirely about
# file size relative to this number and it should not be implicit.
HDFS-SITE.XML_dfs.blocksize=134217728

# No Kerberos, no ACLs. Single-node lab; permission errors here would be noise
# rather than security.
HDFS-SITE.XML_dfs.permissions.enabled=false

# Leave safe mode promptly on a fresh filesystem. The default waits for 99.9% of
# blocks to report, which on an empty cluster is instant, but the 30-second
# extension afterwards is pure delay against a 12-minute budget.
HDFS-SITE.XML_dfs.namenode.safemode.extension=0
HDFS-SITE.XML_dfs.namenode.safemode.threshold-pct=0.9

# Bounded heaps. Without this the JVM sizes itself from container memory and
# the NameNode and DataNode between them will claim more than the tier budget.
HADOOP_HEAPSIZE_MAX=768m
HDFS_NAMENODE_OPTS=-Xmx768m
HDFS_DATANODE_OPTS=-Xmx768m
